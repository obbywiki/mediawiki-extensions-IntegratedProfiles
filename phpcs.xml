<?xml version="1.0"?>
<ruleset>
	<config name="ignore_warnings_on_exit" value="1"/>
	<rule ref="./vendor/mediawiki/mediawiki-codesniffer/MediaWiki">
		<exclude name="MediaWiki.NamingConventions.LowerCamelFunctionsName"/>
		<exclude name="Generic.Files.LineLength.TooLong" />
		<exclude name="MediaWiki.Commenting.MissingCovers"/>
		<exclude name="MediaWiki.Commenting.PropertyDocumentation.MissingDocumentationPrivate" />
		<exclude name="MediaWiki.Commenting.PropertyDocumentation.MissingDocumentationProtected" />
	</rule>
	<rule ref="MediaWiki.Files.ClassMatchesFilename">
		<exclude-pattern>tests/phpunit/*Stub.php</exclude-pattern>
	</rule>
	<rule ref="MediaWiki.Commenting.FunctionComment.MissingDocumentationPublic">
		<exclude-pattern>tests/phpunit/</exclude-pattern>
	</rule>
	<rule ref="MediaWiki.Commenting.FunctionComment.MissingParamTag">
		<exclude-pattern>tests/phpunit/</exclude-pattern>
	</rule>
	<file>src</file>
	<file>tests/phpunit</file> <!-- for future use -->
	<arg name="extensions" value="php"/>
	<arg name="encoding" value="UTF-8"/>
	<exclude-pattern>vendor/</exclude-pattern>
	<exclude-pattern>node_modules/</exclude-pattern>
	<exclude-pattern>resources/dist/</exclude-pattern>
</ruleset>
