{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": false,
		"noImplicitAny": true,
		"jsx": "preserve",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"lib": [ "ES2022", "DOM" ],
		"types": [ "types-mediawiki" ]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.vue",
		"src/**/*.d.ts"
	],
	"exclude": [
		"node_modules",
		"resources/dist"
	]
}
